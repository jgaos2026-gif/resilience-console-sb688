# Backend
NODE_ENV=development
PORT=3001
FRONTEND_ORIGIN=http://localhost:5173
DB_PATH=./data/resilience.db

# REQUIRED outside local dev. Generate a long random value; never commit the real secret.
JWT_SECRET=
ADMIN_PASSWORD=

# Optional Supabase evidence replication. SERVER ONLY.
# Use the project URL and a backend secret/service key. Never prefix the secret with VITE_ and never expose it to browser code.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Frontend may use only a publishable key when/if direct Supabase Auth is enabled later.
# VITE_SUPABASE_URL=
# VITE_SUPABASE_PUBLISHABLE_KEY=
