{
  "name": "CouncilBrief",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "draft",
        "archived"
      ],
      "default": "active"
    },
    "category": {
      "type": "string",
      "enum": [
        "system",
        "business",
        "compliance",
        "roadmap",
        "investor"
      ]
    },
    "visibility": {
      "type": "string",
      "enum": [
        "private",
        "internal",
        "investor",
        "public"
      ],
      "default": "internal"
    },
    "priority": {
      "type": "string",
      "enum": [
        "critical",
        "high",
        "medium",
        "low"
      ],
      "default": "medium"
    }
  },
  "required": [
    "title"
  ]
}