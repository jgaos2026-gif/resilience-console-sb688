{
  "name": "RoadmapItem",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "phase": {
      "type": "string",
      "enum": [
        "phase_1",
        "phase_2",
        "phase_3",
        "phase_4"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "completed",
        "in_progress",
        "planned",
        "future"
      ],
      "default": "planned"
    },
    "description": {
      "type": "string"
    },
    "target_date": {
      "type": "string",
      "format": "date"
    },
    "priority": {
      "type": "string",
      "enum": [
        "critical",
        "high",
        "medium",
        "low"
      ],
      "default": "medium"
    },
    "category": {
      "type": "string",
      "enum": [
        "technical",
        "business",
        "compliance",
        "expansion"
      ]
    }
  },
  "required": [
    "title",
    "phase"
  ]
}